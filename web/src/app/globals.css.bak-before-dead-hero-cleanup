.hero-main {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.72fr);
  gap: clamp(72px, 7vw, 122px);
  align-items: center;
}

.hero-copy {
  min-width: 0;
  max-width: 770px;
}

.hero-eyebrow {
  margin-bottom: 22px;
  color: var(--gi-gold-400);
  font-size: 10px;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

/*
  Desktop line breaks come from Directus textarea.
  Example:
  Manajemen kredit.
  Dari strategi hingga
  pemulihan optimal.
*/

.hero-title,
.hero-id .hero-title,
.hero-en .hero-title {
  width: 100%;
  max-width: 770px;
  margin: 0;
  white-space: pre-line;
  color: #ffffff;
  font-size: clamp(58px, 4.45vw, 74px);
  line-height: 1.015;
  letter-spacing: -0.047em;
  font-weight: 600;
}

.hero-en .hero-title {
  max-width: 760px;
  font-size: clamp(56px, 4.25vw, 71px);
}

.hero-description {
  max-width: 610px;
  margin: 29px 0 0;
  color: rgba(255, 255, 255, 0.63);
  font-size: 15.5px;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.hero-primary,
.hero-secondary {
  min-height: 52px;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  padding: 0 22px;
  font-size: 12px;
  font-weight: 700;
}

.hero-primary {
  background: var(--gi-gold-500);
  color: var(--gi-navy-950);
}

.hero-primary:hover {
  background: var(--gi-gold-400);
}

.hero-secondary {
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.hero-lifecycle {
  width: 100%;
  max-width: 470px;
  justify-self: end;
}

.hero-lifecycle-label {
  margin-bottom: 17px;
  color: var(--gi-gold-400);
  font-size: 9px;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}

.hero-lifecycle-list {
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.hero-lifecycle-item {
  min-height: 82px;
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr);
  gap: 22px;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

.hero-lifecycle-item span {
  color: var(--gi-gold-400);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.hero-lifecycle-item strong {
  color: #ffffff;
  font-size: 18px;
  line-height: 1.25;
  font-weight: 500;
  letter-spacing: -0.022em;
}

/* ---------- TABLET ---------- */

@media (max-width: 1050px) {
  .desktop-nav {
    gap: 20px;
  }

  .hero-main {
    grid-template-columns: 1fr;
    gap: 58px;
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero-lifecycle {
    max-width: 720px;
    justify-self: start;
  }

  .hero-title,
  .hero-id .hero-title,
  .hero-en .hero-title {
    max-width: 720px;
    font-size: clamp(52px, 6.6vw, 68px);
  }
}

/* ---------- MOBILE ---------- */

@media (max-width: 820px) {
  .header-inner {
    min-height: 68px;
  }

  .brand-logo {
    height: 35px !important;
  }

  .desktop-nav {
    display: none !important;
  }

  .language,
  .header-cta {
    display: none;
  }

  .menu-button {
    width: 40px;
    height: 40px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .menu-button span {
    width: 20px;
    height: 1px;
    display: block;
    background: #ffffff;
  }

  .mobile-menu {
    position: absolute;
    z-index: 1200;
    top: 68px;
    left: 0;
    width: 100%;
    display: block;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--gi-navy-950);
  }

  .mobile-menu-inner {
    padding-top: 20px;
    padding-bottom: 28px;
  }

  .mobile-nav-group {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .mobile-nav-trigger,
  .mobile-nav-link {
    width: 100%;
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 0;
    background: transparent;
    color: #ffffff;
    font-size: 15px;
    text-align: left;
  }

  .mobile-subnav {
    display: grid;
    padding: 0 0 18px 16px;
  }

  .mobile-subnav a {
    padding: 9px 0;
    color: rgba(255, 255, 255, 0.64);
    font-size: 13px;
  }

  .mobile-language {
    min-height: 56px;
    display: flex;
    align-items: center;
    color: var(--gi-gold-400);
    font-size: 13px;
  }

  .hero-shell {
    padding-top: 58px;
    padding-bottom: 64px;
  }

  .hero-main {
    gap: 48px;
  }

  .hero-title,
  .hero-id .hero-title,
  .hero-en .hero-title {
    max-width: 100%;
    white-space: normal;
    font-size: clamp(43px, 11vw, 58px);
    line-height: 1;
  }

  .hero-description {
    margin-top: 25px;
    font-size: 15px;
  }

  .hero-primary,
  .hero-secondary {
    width: 100%;
  }

  .hero-lifecycle {
    max-width: none;
  }
}
