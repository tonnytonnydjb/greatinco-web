@import "tailwindcss";

:root {
  --gi-navy-950: #071824;
  --gi-navy-900: #0b2332;
  --gi-navy-800: #123143;

  --gi-jade-700: #2f6b5c;
  --gi-jade-500: #5f8e7f;
  --gi-jade-100: #dfe9e4;

  --gi-gold-500: #b89a5a;
  --gi-gold-400: #c8ad72;
  --gi-gold-100: #eee5d1;

  --gi-ivory-50: #f7f5ef;
  --gi-stone-100: #e9e5dc;

  --gi-slate-500: #66737d;
  --gi-slate-700: #3c4b55;

  --gi-white: #ffffff;
  --gi-black: #101820;

  --container: 1320px;
  --radius-lg: 28px;
  --radius-md: 18px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--gi-ivory-50);
  color: var(--gi-black);
  font-family: Arial, Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.gi-container {
  width: min(calc(100% - 40px), var(--container));
  margin-inline: auto;
}

.gi-section {
  padding: 96px 0;
}

.gi-eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--gi-gold-500);
}

.gi-display {
  margin: 0;
  font-size: clamp(46px, 6vw, 92px);
  line-height: 0.98;
  letter-spacing: -0.055em;
  font-weight: 600;
}

.gi-heading {
  margin: 0;
  font-size: clamp(34px, 4vw, 62px);
  line-height: 1.02;
  letter-spacing: -0.045em;
  font-weight: 600;
}

.gi-body-lg {
  font-size: clamp(17px, 1.5vw, 20px);
  line-height: 1.7;
}

@media (max-width: 768px) {
  .gi-container {
    width: min(calc(100% - 32px), var(--container));
  }

  .gi-section {
    padding: 72px 0;
  }
}

.site-header {
  position: relative;
  z-index: 50;
  background: var(--gi-navy-950);
  color: white;
  border-bottom: 1px solid rgba(255, 255, 255, 0.09);
}

.header-inner {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid rgba(200, 173, 121, 0.7);
  color: var(--gi-gold-400);
  font-size: 16px;
  font-weight: 700;
}

.brand-name {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 30px;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.78);
}

.desktop-nav a {
  transition: color 180ms ease;
}

.desktop-nav a:hover {
  color: white;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.language {
  font-size: 12px;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.72);
}

.header-cta {
  padding: 12px 18px;
  background: var(--gi-gold-500);
  color: var(--gi-navy-950);
  font-size: 13px;
  font-weight: 700;
}

.menu-button {
  display: none;
  width: 44px;
  height: 44px;
  border: 0;
  background: transparent;
  padding: 10px;
  cursor: pointer;
}

.menu-button span {
  display: block;
  height: 1px;
  background: white;
  margin: 7px 0;
}

.mobile-menu {
  display: none;
}

@media (max-width: 980px) {
  .desktop-nav,
  .header-cta {
    display: none;
  }

  .menu-button {
    display: block;
  }

  .mobile-menu {
    display: block;
    background: var(--gi-navy-950);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-menu-inner {
    padding-top: 22px;
    padding-bottom: 26px;
    display: grid;
  }

  .mobile-menu-inner a {
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
  }
}

.hero {
  background:
    radial-gradient(circle at 80% 25%, rgba(185, 154, 97, 0.14), transparent 28%),
    var(--gi-navy-950);
  color: white;
  overflow: hidden;
}

.hero-grid {
  min-height: 720px;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
  gap: 72px;
  align-items: center;
  padding-top: 82px;
  padding-bottom: 92px;
}

.hero-content {
  max-width: 800px;
}

.hero-content .gi-eyebrow {
  margin-bottom: 26px;
}

.hero-content .gi-display {
  max-width: 830px;
}

.hero-description {
  margin: 32px 0 0;
  max-width: 650px;
  color: rgba(255, 255, 255, 0.66);
  font-size: clamp(17px, 1.5vw, 20px);
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 38px;
}

.hero-primary,
.hero-secondary {
  min-height: 52px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 22px;
  font-size: 14px;
  font-weight: 700;
}

.hero-primary {
  background: var(--gi-gold-500);
  color: var(--gi-navy-950);
}

.hero-secondary {
  border: 1px solid rgba(255, 255, 255, 0.22);
  gap: 18px;
}

.hero-visual {
  display: flex;
  justify-content: flex-end;
}

.hero-visual-grid {
  width: min(100%, 480px);
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid rgba(255, 255, 255, 0.16);
  border-left: 1px solid rgba(255, 255, 255, 0.16);
}

.hero-stat {
  min-height: 180px;
  padding: 26px;
  border-right: 1px solid rgba(255, 255, 255, 0.16);
  border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.025);
}

.hero-stat span {
  color: var(--gi-gold-400);
  font-size: 12px;
  letter-spacing: 0.14em;
}

.hero-stat strong {
  font-size: 22px;
  font-weight: 500;
}

@media (max-width: 980px) {
  .hero-grid {
    min-height: 0;
    grid-template-columns: 1fr;
    gap: 64px;
    padding-top: 72px;
  }

  .hero-visual {
    justify-content: stretch;
  }

  .hero-visual-grid {
    width: 100%;
    max-width: none;
  }
}

@media (max-width: 520px) {
  .hero-stat {
    min-height: 140px;
    padding: 20px;
  }

  .hero-stat strong {
    font-size: 17px;
  }

  .hero-actions {
    display: grid;
  }

  .hero-primary,
  .hero-secondary {
    width: 100%;
  }
}

.trust-strip {
  background: white;
  border-bottom: 1px solid var(--gi-stone-100);
}

.trust-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.trust-grid > div {
  padding: 34px 30px;
  border-right: 1px solid var(--gi-stone-100);
}

.trust-grid > div:first-child {
  padding-left: 0;
}

.trust-grid > div:last-child {
  border-right: 0;
}

.trust-number {
  font-size: clamp(28px, 3vw, 44px);
  letter-spacing: -0.04em;
  color: var(--gi-navy-950);
  font-weight: 600;
}

.trust-label {
  margin-top: 6px;
  color: var(--gi-slate-500);
  font-size: 13px;
}

.solutions-section {
  background: var(--gi-ivory-50);
}

.solutions-heading {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 72px;
  align-items: end;
}

.solutions-heading .gi-eyebrow {
  margin-bottom: 22px;
}

.solutions-heading p {
  margin: 0 0 5px;
  color: var(--gi-slate-500);
  font-size: 17px;
  line-height: 1.7;
}

.solution-grid {
  margin-top: 70px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid #d9d5cc;
  border-left: 1px solid #d9d5cc;
}

.solution-card {
  min-height: 300px;
  padding: 28px;
  border-right: 1px solid #d9d5cc;
  border-bottom: 1px solid #d9d5cc;
  display: flex;
  flex-direction: column;
  background: transparent;
}

.solution-card > span {
  color: var(--gi-gold-500);
  font-size: 12px;
}

.solution-card h3 {
  margin: auto 0 28px;
  font-size: 26px;
  line-height: 1.15;
  letter-spacing: -0.03em;
  font-weight: 500;
}

.solution-arrow {
  font-size: 22px;
}

@media (max-width: 980px) {
  .solutions-heading {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .solution-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .trust-grid {
    grid-template-columns: 1fr;
  }

  .trust-grid > div {
    padding: 24px 0;
    border-right: 0;
    border-bottom: 1px solid var(--gi-stone-100);
  }

  .solution-grid {
    grid-template-columns: 1fr;
  }

  .solution-card {
    min-height: 220px;
  }
}

.site-footer {
  background: var(--gi-navy-950);
  color: white;
  padding-top: 76px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 0.7fr 0.7fr;
  gap: 64px;
  padding-bottom: 64px;
}

.footer-brand {
  font-size: 18px;
  letter-spacing: 0.15em;
  font-weight: 700;
}

.footer-grid p {
  max-width: 460px;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.7;
}

.footer-grid > div:not(:first-child) {
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: rgba(255, 255, 255, 0.58);
  font-size: 14px;
}

.footer-label {
  color: var(--gi-gold-400);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 11px;
  margin-bottom: 8px;
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 24px;
  padding-bottom: 28px;
  color: rgba(255, 255, 255, 0.42);
  font-size: 12px;
}

@media (max-width: 760px) {
  .footer-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }
}

.client-marquee-section {
  overflow: hidden;
  background: #ffffff;
  border-bottom: 1px solid var(--gi-stone-100);
}

.client-marquee-heading {
  padding-top: 28px;
}

.client-marquee-heading span {
  display: block;
  color: var(--gi-slate-500);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.client-marquee-viewport {
  position: relative;
  overflow: hidden;
  padding: 24px 0 32px;
}

.client-marquee-viewport::before,
.client-marquee-viewport::after {
  position: absolute;
  z-index: 2;
  top: 0;
  bottom: 0;
  width: 120px;
  content: "";
  pointer-events: none;
}

.client-marquee-viewport::before {
  left: 0;
  background: linear-gradient(to right, #ffffff, transparent);
}

.client-marquee-viewport::after {
  right: 0;
  background: linear-gradient(to left, #ffffff, transparent);
}

.client-marquee-track {
  display: flex;
  width: max-content;
  align-items: center;
  animation: client-marquee 34s linear infinite;
}

.client-marquee-track:hover {
  animation-play-state: paused;
}

.client-logo-item {
  display: flex;
  width: 220px;
  height: 86px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 18px 30px;
}

.client-logo-item img {
  width: auto;
  max-width: 160px;
  max-height: 48px;
  object-fit: contain;
  filter: grayscale(1);
  opacity: 0.58;
  transition:
    filter 180ms ease,
    opacity 180ms ease,
    transform 180ms ease;
}

.client-logo-item:hover img {
  transform: scale(1.03);
  filter: grayscale(0);
  opacity: 1;
}

@keyframes client-marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .client-marquee-track {
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    animation: none;
  }

  .client-logo-item:nth-child(n + 11) {
    display: none;
  }
}

@media (max-width: 640px) {
  .client-marquee-viewport::before,
  .client-marquee-viewport::after {
    width: 50px;
  }

  .client-logo-item {
    width: 170px;
    padding-inline: 22px;
  }

  .client-logo-item img {
    max-width: 125px;
    max-height: 42px;
  }
}

/* === UI refinement: client trust + metrics spacing === */

.client-marquee-section {
  background: #ffffff;
  border-bottom: 0;
  padding-top: 34px;
  padding-bottom: 42px;
}

.client-marquee-heading {
  padding-top: 0;
  padding-bottom: 18px;
}

.client-marquee-heading span {
  color: #7b8490;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.client-marquee-viewport {
  padding: 18px 0 10px;
}

.client-logo-item {
  width: 200px;
  height: 72px;
  padding: 14px 30px;
}

.client-logo-item img {
  max-width: 142px;
  max-height: 38px;
  opacity: 0.48;
  filter: grayscale(1);
}

.client-logo-item:hover img {
  opacity: 0.92;
  filter: grayscale(0);
  transform: scale(1.025);
}

.client-marquee-viewport::before,
.client-marquee-viewport::after {
  width: 90px;
}

.trust-strip {
  background: var(--gi-ivory-50);
  border-top: 1px solid var(--gi-stone-100);
  border-bottom: 1px solid var(--gi-stone-100);
}

.trust-grid {
  min-height: 190px;
  align-items: center;
}

.trust-grid > div {
  padding-top: 44px;
  padding-bottom: 44px;
}

.trust-number {
  font-size: clamp(34px, 3.4vw, 52px);
}

.trust-label {
  margin-top: 10px;
  font-size: 13px;
  color: #74808c;
}

@media (max-width: 640px) {
  .client-marquee-section {
    padding-top: 28px;
    padding-bottom: 30px;
  }

  .client-logo-item {
    width: 150px;
    height: 66px;
    padding-inline: 18px;
  }

  .client-logo-item img {
    max-width: 112px;
    max-height: 34px;
  }

  .trust-grid {
    min-height: 0;
  }
}

/* === Enterprise proof section === */

.trust-strip {
  display: none;
}

.proof-section {
  background: var(--gi-ivory-50);
  padding: 104px 0 30px;
}

.proof-intro {
  padding-bottom: 58px;
}

.proof-intro .gi-eyebrow {
  margin-bottom: 22px;
}

.proof-heading-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
  gap: 72px;
  align-items: end;
}

.proof-heading-grid h2 {
  max-width: 860px;
  margin: 0;
  font-size: clamp(38px, 4.5vw, 68px);
  line-height: 1.02;
  letter-spacing: -0.045em;
  font-weight: 600;
  color: var(--gi-navy-950);
}

.proof-heading-grid p {
  max-width: 520px;
  margin: 0 0 4px;
  color: var(--gi-slate-500);
  font-size: 17px;
  line-height: 1.75;
}

.proof-list {
  border-top: 1px solid #d9d5cc;
}

.proof-item {
  display: grid;
  grid-template-columns: 70px minmax(260px, 0.85fr) minmax(300px, 1fr);
  gap: 36px;
  align-items: center;
  min-height: 150px;
  border-bottom: 1px solid #d9d5cc;
}

.proof-index {
  color: var(--gi-gold-500);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.proof-label {
  margin-bottom: 8px;
  color: var(--gi-slate-500);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.proof-value {
  color: var(--gi-navy-950);
  font-size: clamp(25px, 2.8vw, 42px);
  line-height: 1.05;
  letter-spacing: -0.035em;
  font-weight: 600;
}

.proof-item > p {
  max-width: 620px;
  margin: 0;
  color: var(--gi-slate-500);
  font-size: 15px;
  line-height: 1.7;
}

@media (max-width: 860px) {
  .proof-section {
    padding-top: 76px;
  }

  .proof-heading-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .proof-item {
    grid-template-columns: 46px 1fr;
    gap: 18px 20px;
    padding: 28px 0;
  }

  .proof-item > p {
    grid-column: 2;
  }
}

@media (max-width: 520px) {
  .proof-item {
    grid-template-columns: 32px 1fr;
  }
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 24px;
}

.footer-column a,
.footer-column span {
  transition: color 160ms ease;
}

.footer-column a:hover {
  color: #ffffff;
}

@media (max-width: 640px) {
  .footer-bottom {
    flex-direction: column;
    gap: 8px;
  }
}

.brand-logo {
  width: 190px;
  height: auto;
  object-fit: contain;
}

@media (max-width: 640px) {
  .brand-logo {
    width: 160px;
  }
}

/* === Navigation refinement === */

.nav-item {
  position: relative;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  height: 82px;
}

.nav-chevron {
  font-size: 9px;
  opacity: 0.55;
}

.nav-dropdown {
  position: absolute;
  top: 72px;
  left: 50%;
  min-width: 440px;
  transform: translateX(-50%) translateY(10px);
  background: #ffffff;
  color: var(--gi-navy-950);
  border: 1px solid rgba(7, 19, 31, 0.1);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition:
    opacity 160ms ease,
    transform 160ms ease,
    visibility 160ms ease;
}

.nav-item:hover .nav-dropdown,
.nav-item:focus-within .nav-dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.nav-dropdown-inner {
  display: grid;
  grid-template-columns: 150px 1fr;
  gap: 28px;
  padding: 26px;
}

.nav-dropdown-heading span {
  display: block;
  margin-bottom: 8px;
  color: var(--gi-gold-500);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.nav-dropdown-heading strong {
  font-size: 18px;
  font-weight: 600;
}

.nav-dropdown-links {
  display: grid;
}

.nav-dropdown-links a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 11px 0;
  border-bottom: 1px solid #ece9e2;
  font-size: 13px;
  color: #44505c;
}

.nav-dropdown-links a:last-child {
  border-bottom: 0;
}

.nav-dropdown-links a:hover {
  color: var(--gi-navy-950);
}

.mobile-nav-group {
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.mobile-nav-trigger,
.mobile-nav-link {
  width: 100%;
  min-height: 54px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 0;
  padding: 0;
  background: transparent;
  color: rgba(255, 255, 255, 0.9);
  text-align: left;
}

.mobile-subnav {
  display: grid;
  padding: 0 0 16px 18px;
}

.mobile-subnav a {
  padding: 10px 0;
  border: 0;
  color: rgba(255, 255, 255, 0.58);
  font-size: 14px;
}

.mobile-language {
  margin-top: 16px;
  padding: 14px 0;
  color: var(--gi-gold-400);
}

/* === Hero capability flow === */

.hero-grid {
  grid-template-columns: minmax(0, 1.2fr) minmax(360px, 0.8fr);
}

.capability-flow {
  align-self: center;
  width: min(100%, 500px);
  margin-left: auto;
}

.capability-flow-label {
  padding-bottom: 18px;
  color: var(--gi-gold-400);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.capability-flow-list {
  border-top: 1px solid rgba(255, 255, 255, 0.18);
}

.capability-flow-item {
  min-height: 92px;
  display: grid;
  grid-template-columns: 52px 1fr 28px;
  gap: 18px;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.capability-number {
  color: var(--gi-gold-400);
